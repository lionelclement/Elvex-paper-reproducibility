/************************************************************
* Full E2E-style grammar.
* This grammar realizes a closed-domain restaurant MR as a subject followed
* by slot-specific clauses.  It is intentionally simple, but it is no longer
* a generic slot-marker/value verbalizer.
************************************************************/

@withoutSpaces
Axiom → RestaurantDescription {
  ↓1 = ↑;
  ⇑ = ⇓1;
}


/*** name + no slot ***/
RestaurantDescription → SUBJECT {
  [HEAD:DESCRIBE_RESTAURANT,
   name:$Name
  ];

  ↓1 = [name:$Name];

  ⇑ = ↑;
}

/*** name + eatType ***/
RestaurantDescription → SUBJECT EATTYPE_CLAUSE {
  [HEAD:DESCRIBE_RESTAURANT,
   name:$Name,
   eatType:$EatType
  ];

  ↓1 = [name:$Name];
  ↓2 = [eatType:$EatType];

  ⇑ = ↑;
}

/*** name + food ***/
RestaurantDescription → SUBJECT FOOD_CLAUSE {
  [HEAD:DESCRIBE_RESTAURANT,
   name:$Name,
   food:$Food
  ];

  ↓1 = [name:$Name];
  ↓2 = [food:$Food];

  ⇑ = ↑;
}

/*** name + priceRange ***/
RestaurantDescription → SUBJECT PRICE_CLAUSE {
  [HEAD:DESCRIBE_RESTAURANT,
   name:$Name,
   priceRange:$Price
  ];

  ↓1 = [name:$Name];
  ↓2 = [priceRange:$Price];

  ⇑ = ↑;
}

/*** name + area ***/
RestaurantDescription → SUBJECT AREA_CLAUSE {
  [HEAD:DESCRIBE_RESTAURANT,
   name:$Name,
   area:$Area
  ];

  ↓1 = [name:$Name];
  ↓2 = [area:$Area];

  ⇑ = ↑;
}

/*** name + near ***/
RestaurantDescription → SUBJECT NEAR_CLAUSE {
  [HEAD:DESCRIBE_RESTAURANT,
