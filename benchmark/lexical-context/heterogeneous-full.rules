// Heterogeneous FULL condition. Each top-level daughter receives a different
// predicative-noun input. The noun synthesizes the support specification used
// by the verb, exactly as in the single-case FULL condition.

H1 → S {
    [first:$first];
    ↓1 = $first;
}

H2 → S S {
    [first:$first, second:$second];
    ↓1 = $first;
    ↓2 = $second;
}

H3 → S S S {
    [first:$first, second:$second, third:$third];
    ↓1 = $first;
    ↓2 = $second;
    ↓3 = $third;
}

H4 → S S S S {
    [first:$first, second:$second, third:$third, fourth:$fourth];
    ↓1 = $first;
    ↓2 = $second;
    ↓3 = $third;
    ↓4 = $fourth;
}

S → NP VP dot {
    [i:$subject, ii:$object];
    ↓1 = $subject;
    ↓2 = [OBJECT:$object];
    ↓3 = [];
}

NP → proper_noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

VP → V Det N {
    [OBJECT:$object];
    ↓3 = $object;
    ↓2 = [HEAD:A];

    deferred (⇓3) {
        [support:$support] ⊂ ⇓3;
        ↓1 = $support;
    }
}

V → verb {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

Det → det {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

N → noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}
