// PRE-SPECIFIED: the support-verb specification is supplied in the input.
// This is the control condition for FULL: it obtains the same lexical control
// by specifying in advance what FULL learns from nominal lexicalization.

T1 → S {
    ↓1 = ↑;
}

S → NP VP dot {
    [i:$subject, ii:$object, support:$support];
    ↓1 = $subject;
    ↓2 = [OBJECT:$object, support:$support];
    ↓3 = [];
}

NP → proper_noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

VP → V Det N {
    [OBJECT:$object, support:$support];
    ↓1 = $support;
    ↓2 = [HEAD:A];
    ↓3 = $object;
}

V → verb {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

Det → det {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

N → noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}
