// NO-CONTEXT: the predicative noun is lexicalized exactly as in FULL, but the
// support structure synthesized by it is ignored. Support verbs are exposed
// through a dedicated terminal whose lexical entries deliberately have no HEAD.

T1 → S {
    ↓1 = ↑;
}

S → NP VP dot {
    [i:$subject, ii:$object];
    ↓1 = $subject;
    ↓2 = [OBJECT:$object];
    ↓3 = [];
}

NP → proper_noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

// The noun's synthesized support constraint is deliberately not consulted.
// With no HEAD on V, Elvex selects entries by terminal name. The dedicated
// support_verb terminal therefore exposes the full nine-verb inventory.
VP → V Det N {
    [OBJECT:$object];
    ↓1 = [];
    ↓2 = [HEAD:A];
    ↓3 = $object;
}

V → support_verb {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

Det → det {
    ↓1 = ↑;
    ⇑ = ⇓1;
}

N → noun {
    ↓1 = ↑;
    ⇑ = ⇓1;
}
